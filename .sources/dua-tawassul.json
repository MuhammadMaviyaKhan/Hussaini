    {
      "type": "dua",
      "id": "dua-1",
      "title": "Dua Tawassul",
      "description": "Seeking Intercession through Ahlulbayt(as)<br>Highly recommended on Tuesday, or on the eve of Tuesday (Monday night after Maghrib)",
      "segments": [
        {
          "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ وَأَتَوَجَّهُ إِلَيْكَ",
          "transliteration": "allahumma inni as'aluka wa atawajjahu ilayka",
          "translation": "O Allah, I beseech You and turn my face toward You"
        },
        {
          "arabic": "بِنَبِيِّكَ نَبِيِّ ٱلرَّحْمَةِ",
          "transliteration": "binabiyyika nabiyyi alrrahmati",
          "translation": "in the name of Your Prophet; the Prophet of Mercy,"
        },
        {
          "arabic": "مُحَمَّدٍ صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ",
          "transliteration": "muhammadin salla allahu `alayhi wa alihi",
          "translation": "Muhammad—may Allah send blessings to him and his Household."
        },
        {
          "arabic": "يَا أَبَا ٱلْقَاسِمِ",
          "transliteration": "ya aba alqasimi",
          "translation": "O Abu’l-Qasim!"
        },
        {
          "arabic": "يَا رَسُولَ ٱللَّهِ",
          "transliteration": "ya rasula allahi",
          "translation": "O Allah’s Messenger!"
        },
        {
          "arabic": "يَا إِمَامَ ٱلرَّحْمَةِ",
          "transliteration": "ya imama alrrahmati",
          "translation": "O Chief of Mercy!"
        },
        {
          "arabic": "يَا سَيِّدَنَا وَمَوْلاَنَا",
          "transliteration": "ya sayyidana wa mawlana",
          "translation": "O our master and chief!"
        },
        {
          "arabic": "إِنَّا تَوَجَّهْنَا وَٱسْتَشْفَعْنَا",
          "transliteration": "inna tawajjahana wastashfa`na",
          "translation": "We are turning our faces toward you, seeking your intercession"
        },
        {
          "arabic": "وَتَوَسَّلْنَا بِكَ إِلَىٰ ٱللَّهِ",
          "transliteration": "wa tawassalna bika ila allahi",
          "translation": "and your advocacy for us before Allah;"
        },
        {
          "arabic": "وَقَدَّمْنَاكَ بَيْنَ يَدَيْ حَاجَاتِنَا",
          "transliteration": "wa qaddamnaka bayna yaday hajatina",
          "translation": "and we are presenting you [as our intermediary] for the settlement of our needs."
        },
        {
          "arabic": "يَا وَجِيهاً عِنْدَ ٱللَّهِ",
          "transliteration": "ya wajihan `inda allahi",
          "translation": "O well-esteemed with Allah,"
        },
        {
          "arabic": "إِشْفَعْ لَنَا عِنْدَ ٱللَّهِ",
          "transliteration": "ishfa` lana `inda allahi",
          "translation": "intercede for us before Allah."
        },
        {
          "arabic": "يَا أَبَا ٱلْحَسَنِ",
          "transliteration": "ya aba alhasani",
          "translation": "O Abu’l-Hasan!"
        },
        {
          "arabic": "يَا أَمِيرَ ٱلْمُؤْمِنِينَ",
          "transliteration": "ya amira almu'minina",
          "translation": "O commander of the Believers!"
        },
        {
          "arabic": "يَا عَلِيُّ بْنَ أَبِي طَالِبٍ",
          "transliteration": "ya `aliyyu bna abi talibin",
          "translation": "O `Ali, son of Abu-Talib!"
        },
        {
          "arabic": "يَا حُجَّةَ ٱللَّهِ عَلَىٰ خَلْقِهِ",
          "transliteration": "ya hujjata allahi `ala khalqihi",
          "translation": "O Allah’s Argument against His creatures!"
